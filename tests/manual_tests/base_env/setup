#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"

. "$REPO_ROOT/tests/e2e_tests/lib/helpers.sh"

# --- Defaults ---
PENDING_COUNT=5

# --- Usage ---
usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Set up a local asfaload test environment for manual CLI testing.

Starts a local rest-api backend and file server, creates and activates a
signers file (key_0, key_1, key_2; threshold 2), registers PENDING_COUNT
pending release files, then drops you into an interactive shell with all
connection details pre-set as environment variables.

Type 'exit' in the shell to stop all servers and clean up.

OPTIONS
  --pending-count N   Number of pending release files to register (default: $PENDING_COUNT)
  -h, --help          Show this help message and exit

ENVIRONMENT SET IN SPAWNED SHELL
  ASFALOAD_BACKEND_URL   Backend REST API address
  ASFALOAD_PASSWORD_FILE Path to file containing the key password
  KEY_0 KEY_1 KEY_2      Paths to fixture private keys
  FILE_SERVER_URL        Local file server address
  PATH                   target/debug prepended (asfaload-cli available directly)

EXAMPLES
  # Default: spin up with 5 pending files
  $(basename "$0")

  # Spin up with 3 pending files (faster)
  $(basename "$0") --pending-count 3

  # Inside the spawned shell:
  asfaload-cli list-pending -K \$KEY_0
  asfaload-cli sign-pending -K \$KEY_0
EOF
}

# --- Argument parsing ---
while [[ $# -gt 0 ]]; do
    case "$1" in
        --pending-count)
            PENDING_COUNT="${2:?--pending-count requires a value}"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            printf '%sUnknown argument: %s%s\n' "$RED" "$1" "$RESET" >&2
            usage >&2
            exit 1
            ;;
    esac
done

# --- Temp workspace ---
WORK_DIR=$(mktemp -d)
SERVER_PID=""
FILE_SERVER_PID=""

PASSWORD_FILE="$WORK_DIR/password"
printf '%s' "$key_password" > "$PASSWORD_FILE"
export ASFALOAD_PASSWORD_FILE="$PASSWORD_FILE"

cleanup() {
    [[ -n "$SERVER_PID" ]] && kill "$SERVER_PID" 2>/dev/null || true
    [[ -n "$FILE_SERVER_PID" ]] && kill "$FILE_SERVER_PID" 2>/dev/null || true
    [[ -n "$SERVER_PID" ]] && wait "$SERVER_PID" 2>/dev/null || true
    [[ -n "$FILE_SERVER_PID" ]] && wait "$FILE_SERVER_PID" 2>/dev/null || true
    rm -rf "$WORK_DIR"
}
trap cleanup EXIT

# --- Build ---
printf '%sBuilding binaries...%s ' "$DIM" "$RESET"
cargo build --quiet \
    --manifest-path "$REPO_ROOT/Cargo.toml" \
    -p rest-api -p test-file-server -p client-cli 2>&1
printf '%s✓%s\n' "$GREEN" "$RESET"

CLI="$REPO_ROOT/target/debug/asfaload-cli"

# --- File server ---
FS_ROOT="$WORK_DIR/fs"
PROJECT_DIR="$FS_ROOT/project"
mkdir -p "$PROJECT_DIR/$HIDDEN_SIGNERS_DIR"

FILE_SERVER_LOG="$WORK_DIR/file-server.log"
"$REPO_ROOT/target/debug/test-file-server" --dir "$FS_ROOT" \
    > "$FILE_SERVER_LOG" 2>&1 &
FILE_SERVER_PID=$!

printf '%sStarting file server...%s ' "$DIM" "$RESET"
FILE_SERVER_PORT=""
for i in $(seq 1 30); do
    FILE_SERVER_PORT=$(grep -oP 'LISTENING_PORT=\K[0-9]+' "$FILE_SERVER_LOG" 2>/dev/null || true)
    [[ -n "$FILE_SERVER_PORT" ]] && break
    if ! kill -0 "$FILE_SERVER_PID" 2>/dev/null; then
        printf '%s✗%s\n' "$RED" "$RESET"
        printf '%sFile server process died unexpectedly.%s\n' "$RED" "$RESET" >&2
        exit 1
    fi
    sleep 0.2
done

if [[ -z "$FILE_SERVER_PORT" ]]; then
    printf '%s✗%s\n' "$RED" "$RESET"
    printf '%sFile server did not report a port within 6 seconds.%s\n' "$RED" "$RESET" >&2
    exit 1
fi

FILE_SERVER_URL="http://localhost:${FILE_SERVER_PORT}"
printf '%s✓ %s%s\n' "$GREEN" "$FILE_SERVER_URL" "$RESET"

# --- Backend ---
BACKEND_REPO="$WORK_DIR/repo"
init_backend_repo "$BACKEND_REPO"
export ASFALOAD_GIT_REPO_PATH="$BACKEND_REPO"
export ASFALOAD_GIT_BACKEND="sha256"

BACKEND_PORT=$((3000 + RANDOM % 1000))
export ASFALOAD_SERVER_PORT="$BACKEND_PORT"
BACKEND_URL="http://localhost:${BACKEND_PORT}"

SERVER_LOG="$WORK_DIR/server.log"
"$REPO_ROOT/target/debug/rest-api" > "$SERVER_LOG" 2>&1 &
SERVER_PID=$!

printf '%sStarting backend...%s ' "$DIM" "$RESET"
for i in $(seq 1 30); do
    if curl "$BACKEND_URL" --silent > /dev/null 2>&1; then
        break
    fi
    if ! kill -0 "$SERVER_PID" 2>/dev/null; then
        printf '%s✗%s\n' "$RED" "$RESET"
        printf '%sBackend process died unexpectedly.%s\n' "$RED" "$RESET" >&2
        exit 1
    fi
    sleep 0.5
done

if ! curl "$BACKEND_URL" --silent > /dev/null 2>&1; then
    printf '%s✗%s\n' "$RED" "$RESET"
    printf '%sBackend did not become ready within 15 seconds.%s\n' "$RED" "$RESET" >&2
    exit 1
fi

printf '%s✓ %s%s\n' "$GREEN" "$BACKEND_URL" "$RESET"

# --- Signers file activation ---
printf '%sActivating signers file...%s ' "$DIM" "$RESET"

SIGNERS_FILE_NAME="signers_file_1${_SIGNERS_SUFFIX}.json"
SIGNERS_FILE_PATH="$PROJECT_DIR/$HIDDEN_SIGNERS_DIR/$SIGNERS_FILE_NAME"
SIGNERS_FILE_URL="$FILE_SERVER_URL/project/$HIDDEN_SIGNERS_DIR/$SIGNERS_FILE_NAME"

"$CLI" new-signers-file \
    --artifact-signers-file "${KEY_0}.pub" \
    --artifact-signers-file "${KEY_1}.pub" \
    --artifact-signers-file "${KEY_2}.pub" \
    -A 2 \
    -o "$SIGNERS_FILE_PATH" \
    > /dev/null 2>&1

"$CLI" register-repo \
    --secret-key "$KEY_0" \
    -u "$BACKEND_URL" \
    "$SIGNERS_FILE_URL" \
    --json > /dev/null

_PENDING_JSON=$("$CLI" list-pending \
    --secret-key "$KEY_0" \
    -u "$BACKEND_URL" \
    --json)
_PENDING_PATH=$(echo "$_PENDING_JSON" | jq -r \
    --arg pat "$PENDING_SIGNERS_DIR" \
    '.pending_files[] | select(.path | contains($pat)) | .path' | head -1)
_PENDING_DIGEST=$(echo "$_PENDING_JSON" | jq -r \
    --arg pat "$PENDING_SIGNERS_DIR" \
    '.pending_files[] | select(.path | contains($pat)) | .digest' | head -1)

# All three signers must sign the initial signers file to activate it
for _KEY in "$KEY_0" "$KEY_1" "$KEY_2"; do
    "$CLI" sign-pending \
        --secret-key "$_KEY" \
        -u "$BACKEND_URL" \
        "$_PENDING_PATH" --digest "$_PENDING_DIGEST" \
        --json > /dev/null
done
unset _KEY _PENDING_JSON _PENDING_PATH _PENDING_DIGEST

printf '%s✓%s\n' "$GREEN" "$RESET"

# --- Register pending releases ---
printf '%sRegistering %d pending releases...%s ' "$DIM" "$PENDING_COUNT" "$RESET"

for _I in $(seq 1 "$PENDING_COUNT"); do
    RELEASE_DIR="$PROJECT_DIR/releases/v0.$_I"
    mkdir -p "$RELEASE_DIR"
    dd if=/dev/urandom of="$RELEASE_DIR/artifact.bin" bs=1024 count=4 2>/dev/null
    (cd "$RELEASE_DIR" && sha256sum artifact.bin > SHA256SUMS)

    "$CLI" register-assets \
        --secret-key "$KEY_0" \
        -u "$BACKEND_URL" \
        --csum-file "$FILE_SERVER_URL/project/releases/v0.$_I/SHA256SUMS" \
        --json > /dev/null
done
unset _I RELEASE_DIR

printf '%s✓%s\n' "$GREEN" "$RESET"

# --- Welcome message ---
printf '\n'
printf '%s━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━%s\n' "$BOLD" "$RESET"
printf '%s  asfaload manual test environment ready%s\n' "$GREEN" "$RESET"
printf '\n'
printf '  %-22s %s\n' "ASFALOAD_BACKEND_URL" "$BACKEND_URL"
printf '  %-22s %s\n' "ASFALOAD_PASSWORD_FILE" "$PASSWORD_FILE"
printf '  %-22s %s\n' "FILE_SERVER_URL" "$FILE_SERVER_URL"
printf '  %-22s %s\n' "KEY_0" "$KEY_0"
printf '  %-22s %s\n' "KEY_1" "$KEY_1"
printf '  %-22s %s\n' "KEY_2" "$KEY_2"
printf '\n'
printf '%s  %d files pending signature%s\n' "$DIM" "$PENDING_COUNT" "$RESET"
printf '  asfaload-cli is in PATH\n'
printf '\n'
printf '%s  Try:%s\n' "$BOLD" "$RESET"
printf '    asfaload-cli list-pending -K $KEY_0\n'
printf '    asfaload-cli sign-pending -K $KEY_0\n'
printf '\n'
printf '%s  Type '"'"'exit'"'"' to stop servers and clean up.%s\n' "$DIM" "$RESET"
printf '%s━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━%s\n\n' "$BOLD" "$RESET"

# --- RC file for subshell ---
RC_FILE="$WORK_DIR/env.sh"
cat > "$RC_FILE" <<RCEOF
[ -f ~/.bashrc ] && source ~/.bashrc

export ASFALOAD_BACKEND_URL="${BACKEND_URL}"
export ASFALOAD_PASSWORD_FILE="${PASSWORD_FILE}"
export KEY_0="${KEY_0}"
export KEY_1="${KEY_1}"
export KEY_2="${KEY_2}"
export FILE_SERVER_URL="${FILE_SERVER_URL}"
export PATH="${REPO_ROOT}/target/debug:\$PATH"

PS1="[asfaload-dev] \w\$ "
RCEOF

bash --rcfile "$RC_FILE"
