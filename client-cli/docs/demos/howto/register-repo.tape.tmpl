Output out/register-repo.gif

Set Shell "bash"
Set Width 1200
Set Height 700
Set TypingSpeed $TYPING_SPEED
Set PlaybackSpeed 1.0

Type "# 1. The signers file is already published. Its URL:"
Enter
Type 'echo "$ASFALOAD_DEMO_SIGNERS_URL"'
Enter
$SLEEP 2s

Type "# 2. Register the repository against the backend"
Enter
Type 'asfaload-cli register-repo --secret-key ~/.asfaload/key_0 --password-file ~/.asfaload/.demo-password -u "$ASFALOAD_DEMO_BACKEND_URL" "$ASFALOAD_DEMO_SIGNERS_URL"'
Enter
$SLEEP 6s
