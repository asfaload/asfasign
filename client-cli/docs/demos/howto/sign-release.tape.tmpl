Output out/sign-release.gif

Set Shell "bash"
Set Width 1200
Set Height 700
Set TypingSpeed $TYPING_SPEED
Set PlaybackSpeed 1.0

Type 'asfaload-cli sign-pending --secret-key ~/.asfaload/key_0 "$ASFALOAD_DEMO_RELEASE_INDEX_PATH"'
Enter
$SLEEP 3s

Type 'asfaload-cli sign-pending --secret-key ~/.asfaload/key_1 "$ASFALOAD_DEMO_RELEASE_INDEX_PATH"'
Enter
Sleep $END_PAUSE
