Output out/generate-keys.gif

Set Shell "bash"
Set Width 1200
Set Height 700
Set TypingSpeed $TYPING_SPEED
Set PlaybackSpeed 1.0
Type "# Accepting weak password for this demo, don't do it in prod!"
Enter
Type "asfaload-cli new-keys --name mykey --output-dir ~/.asfaload --password-file ~/.asfaload/.demo-password --accept-weak-password"
Enter
Sleep $END_PAUSE
